# ============================================================
# MARFIL Clínica Dental — Variables de entorno
# Copiar a .env.local (no commitear). En Vercel: configurar en
# Project Settings → Environment Variables.
# ============================================================

# ── Supabase (Fase 2: persistencia de citas) ─────────────────
# Dashboard: https://supabase.com/dashboard → tu proyecto → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # ⚠ server-only, nunca exponer al cliente

# ── Resend (Fase 2: emails transaccionales) ──────────────────
# Dashboard: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx
# Remitente verificado. En dev/test puedes usar onboarding@resend.dev.
# En producción debe ser un dominio verificado en Resend.
RESEND_FROM_EMAIL="MARFIL Clínica Dental <citas@tudominio.co>"
# Buzón interno que recibe la notificación de nueva solicitud.
RESEND_NOTIFY_EMAIL=staff@tudominio.co
