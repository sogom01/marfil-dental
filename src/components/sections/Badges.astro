---
const badges = [
  {
    title: 'Tecnología 3D',
    desc: 'Diagnóstico preciso',
    svg: '<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>',
  },
  {
    title: 'Financiación',
    desc: 'Hasta 12 cuotas',
    svg: '<rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/><line x1="6" y1="15" x2="8" y2="15"/><line x1="10" y1="15" x2="14" y2="15"/>',
  },
  {
    title: 'Horario amplio',
    desc: 'Sábados incluidos',
    svg: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
  },
  {
    title: 'Primera valoración',
    desc: 'Sin costo',
    svg: '<path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>',
  },
]
---

<section class="trust-band">
  <div class="wrap trust-grid">
    {
      badges.map(({ title, desc, svg }) => (
        <div class="trust-item">
          <div
            class="trust-icon"
            set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" width="24" height="24" aria-hidden="true">${svg}</svg>`}
          />
          <div class="trust-copy">
            <strong>{title}</strong>
            <span>{desc}</span>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  /* ── Sección ─────────────────────────────────────────────── */
  .trust-band {
    background: var(--color-bg);
    padding: clamp(28px, 5vh, 52px) 0;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  /* ── Grid desktop: 4 columnas centradas ──────────────────── */
  .trust-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .trust-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 14px;
    padding: 8px 28px;
    position: relative;
  }

  /* Divisor vertical entre items (pseudo-elemento) */
  .trust-item + .trust-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 1px;
    height: 52%;
    background: var(--color-line);
  }

  /* ── Icono con gradiente teal ────────────────────────────── */
  .trust-icon {
    width: 54px;
    height: 54px;
    border-radius: 16px;
    background: linear-gradient(135deg, var(--color-teal), var(--color-teal-deep));
    color: #fff;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  /* ── Texto centrado ──────────────────────────────────────── */
  .trust-copy strong {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-navy);
    display: block;
    line-height: 1.25;
    margin-bottom: 3px;
  }
  .trust-copy span {
    font-size: 0.83rem;
    color: var(--color-navy-soft);
  }

  /* ── Móvil: 4 tarjetas flotantes en 2×2 ─────────────────── */
  @media (max-width: 900px) {
    .trust-band {
      padding: clamp(20px, 4vh, 36px) 0;
    }
    .trust-grid {
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }
    .trust-item {
      background: white;
      border-radius: 20px;
      padding: 24px 16px;
      gap: 12px;
      box-shadow: 0 2px 16px rgba(14, 58, 71, 0.08);
    }
    /* ocultar divisores en móvil */
    .trust-item + .trust-item::before {
      display: none;
    }
  }

  /* ── Móvil pequeño (< 400 px) ───────────────────────────── */
  @media (max-width: 400px) {
    .trust-grid {
      gap: 10px;
    }
    .trust-item {
      padding: 20px 14px;
      border-radius: 16px;
    }
    .trust-icon {
      width: 46px;
      height: 46px;
      border-radius: 13px;
    }
    .trust-copy strong {
      font-size: 0.93rem;
    }
  }
</style>
