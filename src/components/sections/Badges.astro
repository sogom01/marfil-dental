---
const perks = [
  { title: 'Tecnología 3D', desc: 'Diagnóstico preciso' },
  { title: 'Financiación', desc: 'Hasta 12 cuotas' },
  { title: 'Horario amplio', desc: 'Sábados incluidos' },
  { title: 'Primera valoración', desc: 'Sin costo' },
]
---

<section class="perks-band">
  <div class="wrap perks-grid">
    {
      perks.map(({ title, desc }, i) => (
        <div class="perk">
          <span class="perk-num">{String(i + 1).padStart(2, '0')}</span>
          <strong class="perk-title">{title}</strong>
          <span class="perk-desc">{desc}</span>
        </div>
      ))
    }
  </div>
</section>

<style>
  /* ── Sección ─────────────────────────────────────────────── */
  .perks-band {
    background: white;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    padding: clamp(28px, 5vh, 52px) 0;
  }

  /* ── Grid desktop: 4 cols con divisores ──────────────────── */
  .perks-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .perk {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 0 32px;
    border-right: 1px solid var(--color-line);
  }
  .perk:first-child {
    padding-left: 0;
  }
  .perk:last-child {
    border-right: none;
    padding-right: 0;
  }

  /* ── Número teal ─────────────────────────────────────────── */
  .perk-num {
    font-family: var(--font-display);
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--color-teal);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  /* ── Título ──────────────────────────────────────────────── */
  .perk-title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-navy);
    line-height: 1.2;
  }

  /* ── Descripción ─────────────────────────────────────────── */
  .perk-desc {
    font-size: 0.85rem;
    color: var(--color-navy-soft);
    line-height: 1.4;
  }

  /* ── Móvil: 2×2 sin separadores, solo espaciado ─────────── */
  @media (max-width: 900px) {
    .perks-grid {
      grid-template-columns: 1fr 1fr;
      gap: 28px 24px;
    }
    .perk {
      border-right: none;
      padding: 0;
      gap: 6px;
    }
    .perk:first-child {
      padding-left: 0;
    }
    .perk:last-child {
      padding-right: 0;
    }
    .perk-num {
      font-size: 1.8rem;
    }
  }

  /* ── Móvil pequeño ───────────────────────────────────────── */
  @media (max-width: 400px) {
    .perks-grid {
      gap: 24px 16px;
    }
    .perk-num {
      font-size: 1.5rem;
    }
    .perk-title {
      font-size: 0.97rem;
    }
  }
</style>
