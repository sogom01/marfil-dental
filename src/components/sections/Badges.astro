---
const badges = [
  { icon: '🛡️', title: 'Tecnología 3D', desc: 'Diagnóstico preciso' },
  { icon: '💳', title: 'Financiación', desc: 'Hasta 12 cuotas' },
  { icon: '🕐', title: 'Horario amplio', desc: 'Sábados incluidos' },
  { icon: '🤍', title: 'Primera valoración', desc: 'Sin costo' },
]
---

<section class="bg-white">
  <div class="wrap badges-grid">
    {
      badges.map(({ icon, title, desc }) => (
        <div class="flex items-center gap-3.5">
          <span class="text-[1.6rem]">{icon}</span>
          <div>
            <b class="font-display block text-[1rem]">{title}</b>
            <span class="text-navy-soft text-[.85rem]">{desc}</span>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .badges-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    padding: clamp(28px, 4vh, 48px) 0;
  }
  /* tablet → 2×2, se mantiene hasta pantallas muy pequeñas */
  @media (max-width: 900px) {
    .badges-grid {
      grid-template-columns: 1fr 1fr;
      gap: 20px 28px;
    }
  }
</style>
