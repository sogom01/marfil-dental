---
const steps = [
  {
    n: 1,
    title: 'Agendas en minutos',
    desc: 'Escríbenos por WhatsApp y elige el horario que mejor te quede.',
  },
  {
    n: 2,
    title: 'Valoración gratuita',
    desc: 'Revisamos tu caso y te explicamos opciones y precios sin compromiso.',
  },
  {
    n: 3,
    title: 'Empezamos tu plan',
    desc: 'Avanzamos a tu ritmo, con financiación si la necesitas.',
  },
]
---

<section class="section-pad" id="proceso">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow">Tu primera visita</span>
      <h2>Simple, claro y sin sorpresas</h2>
    </div>
    <div class="steps-grid">
      {
        steps.map(({ n, title, desc }) => (
          <div class="step reveal">
            <div class="step-no">{n}</div>
            <h4>{title}</h4>
            <p>{desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .steps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .step {
    background: white;
    border-radius: 22px;
    padding: 34px 30px;
  }
  .step-no {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 800;
    color: #fff;
    background: var(--color-teal);
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    margin-bottom: 18px;
  }
  .step h4 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    margin-bottom: 8px;
  }
  .step p {
    color: var(--color-navy-soft);
    font-size: 0.95rem;
  }

  @media (max-width: 900px) {
    .steps-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
