---
import '@/styles/global.css'
import Nav from '@/components/nav/Nav.astro'

interface Props {
  title: string
  description?: string
}
const {
  title,
  description = 'Odontología moderna, cálida y sin dolor en Manizales. Ortodoncia, implantes, estética dental y más. Agenda tu primera valoración.',
} = Astro.props

const year = new Date().getFullYear()

const footerServices = ['Ortodoncia', 'Implantes', 'Estética dental', 'Odontopediatría']
const footerClinica = [
  { href: '/#nosotros', label: 'Nosotros' },
  { href: '/#proceso', label: 'Tu visita' },
  { href: '/#opiniones', label: 'Opiniones' },
]
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Favicon -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <!-- TODO bloque D: reemplazar con fuentes self-hosted -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Schibsted+Grotesk:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-bg text-navy overflow-x-hidden font-sans">
    <Nav />
    <slot />

    <footer class="footer-mt bg-white pt-16 pb-8">
      <div class="wrap">
        <div class="footer-cols border-line border-b pb-9">
          <div class="max-w-[300px]">
            <a href="/" class="logo-brand"><span class="mark-badge">✦</span>MARFIL</a>
            <p class="text-navy-soft mt-3.5 text-[.92rem]">
              Clínica dental en Manizales. Odontología moderna, cálida y sin dolor para toda la
              familia.
            </p>
          </div>

          <div>
            <h4 class="font-display mb-3.5 text-[.95rem] font-extrabold">Servicios</h4>
            {
              footerServices.map((s) => (
                <a
                  href="/#servicios"
                  class="text-navy-soft hover:text-teal mb-2 block text-[.92rem] transition-colors"
                >
                  {s}
                </a>
              ))
            }
          </div>

          <div>
            <h4 class="font-display mb-3.5 text-[.95rem] font-extrabold">Clínica</h4>
            {
              footerClinica.map(({ href, label }) => (
                <a
                  href={href}
                  class="text-navy-soft hover:text-teal mb-2 block text-[.92rem] transition-colors"
                >
                  {label}
                </a>
              ))
            }
          </div>

          <div>
            <h4 class="font-display mb-3.5 text-[.95rem] font-extrabold">Contacto</h4>
            <p class="text-navy-soft mb-2 text-[.92rem]">
              Carrera 11 # 14-110, Chipre<br />Manizales, Caldas
            </p>
            <p class="text-navy-soft mb-2 text-[.92rem]">+57 314 713 2470</p>
            <p class="text-navy-soft mb-2 text-[.92rem]">Lun–Vie 8am–7pm · Sáb 8am–1pm</p>
          </div>
        </div>
        <div class="footer-bar text-navy-soft pt-6 text-[.82rem]">
          <span>© {year} MARFIL Clínica Dental.</span>
          <a
            href="/politica-privacidad"
            class="hover:text-teal underline underline-offset-[3px] transition-colors"
          >
            Política de privacidad
          </a>
          <!-- TODO: reemplazar con email real cuando tengas dominio definitivo -->
          <span>citas@tudominio.co</span>
        </div>
      </div>
    </footer>

    <!-- WhatsApp flotante -->
    <a
      href="https://wa.me/573147132470"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Contactar por WhatsApp"
      class="fixed right-[22px] bottom-[22px] z-[200] grid size-[58px] place-items-center rounded-full bg-[#25D366] shadow-[0_10px_30px_rgba(37,211,102,.45)] transition-transform hover:scale-[1.08]"
    >
      <svg class="size-[30px] fill-white" viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.945C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 018.413 3.488 11.824 11.824 0 013.48 8.413c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.82 9.82 0 001.518 5.276l-.999 3.648 3.971-1.042zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"
        ></path>
      </svg>
    </a>

    <style is:global>
      /* ── Footer grid responsivo ─────────────────────────── */
      .footer-cols {
        display: grid;
        grid-template-columns: 1.8fr 1fr 1fr 1fr;
        gap: clamp(20px, 4vw, 40px);
      }
      /* tablet: 2×2 */
      @media (max-width: 700px) {
        .footer-cols {
          grid-template-columns: 1fr 1fr;
        }
      }
      /* móvil pequeño: 1 col */
      @media (max-width: 400px) {
        .footer-cols {
          grid-template-columns: 1fr;
        }
      }

      /* ── Footer barra inferior ──────────────────────────── */
      .footer-bar {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 0.75rem;
      }
      @media (max-width: 520px) {
        .footer-bar {
          flex-direction: column;
          align-items: flex-start;
          gap: 0.35rem;
        }
      }

      /* ── section-pad reducido en móvil ─────────────────── */
      @media (max-width: 560px) {
        .section-pad {
          padding: clamp(56px, 9vh, 80px) 0;
        }
      }
    </style>

    <script>
      // IntersectionObserver para animaciones .reveal en todas las páginas
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('in')
              io.unobserve(e.target)
            }
          }),
        { threshold: 0.13 },
      )
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el))
    </script>
  </body>
</html>
